# Server Port & Environment
PORT=5000
NODE_ENV=development

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
# Replace with your actual MongoDB connection URI (e.g. mongodb://localhost:27017/hazard_response)
MONGODB_URI=mongodb://127.0.0.1:27017/hazard_response

# Authentication Tokens
# Generate high-entropy strings for secrets (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_access_secret_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# Ingestion Secret for AI & Sensor Services
INGEST_API_KEY=your_ingest_api_key_change_in_production

# Python AI Inference Service
INFERENCE_SERVICE_URL=http://127.0.0.1:8000
